{
  "name": "neolit",
  "version": "0.1.0",
  "description": "Pure solution graph: bounded CSP + CEGAR + AND/OR LOD solver over any agent harness",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist/",
    "LICENSE",
    "README.md",
    "SOLUTION-GRAPH-CORE-IDEAS.md",
    "ARCHITECTURE.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "check": "tsc -p tsconfig.json --noEmit && vitest run",
    "prepack": "npm run check && npm run build"
  },
  "keywords": [
    "agents",
    "langgraph",
    "csp",
    "wfc",
    "cegar",
    "task-decomposition",
    "solver"
  ],
  "author": "1suo",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/1suo/opencode-langgraph.git"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@langchain/core": "^1.2.9",
    "@langchain/langgraph": "^1.4.9",
    "@langchain/langgraph-checkpoint": "^1.1.5",
    "jiti": "^2.6.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
