{
  "name": "neolit",
  "version": "0.6.25",
  "description": "Git-native planning and diff traceability core",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./planning": {
      "types": "./dist/planning/index.d.ts",
      "default": "./dist/planning/index.js"
    }
  },
  "files": [
    "dist/",
    "LICENSE",
    "README.md",
    "src/planning/README.md",
    "src/planning/"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "test": "vitest run",
    "check": "tsc -p tsconfig.json --noEmit && vitest run",
    "prepack": "npm run check && npm run build"
  },
  "keywords": [
    "git",
    "planning",
    "diff",
    "traceability",
    "markdown",
    "coding-agents"
  ],
  "author": "1suo",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^24.10.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
